# ─────────────────────────────────────────────────────────────
# SECRETS ONLY — copy this file to dev.local and fill in values
# NEVER commit dev.local to git
# ─────────────────────────────────────────────────────────────

# Database password
DB_PASSWORD=postgres

# JWT signing secrets (use long random strings)
JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-too

# Dev OTP (used when NODE_ENV=development)
DEV_OTP=123456

# Super admin seed credentials
SUPER_ADMIN_PHONE=9000000001
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Razorpay (leave empty to use dev mock payment)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (only when STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# SMS / WhatsApp (Twilio) — leave empty to log messages in dev console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1234567890
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (SMTP-compatible API) — leave empty to log messages in dev console
# SMTP_HOST=https://api.resend.com
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# SMTP_FROM=Localite <noreply@yourdomain.com>

# Optional Google reCAPTCHA secret (server-side verify)
# RECAPTCHA_SECRET_KEY=
