PORT=5000
NODE_ENV=development

# Database (password goes in dev.local)
DB_NAME=localite_db
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT timing (secrets go in dev.local)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Auth settings (OTP value goes in dev.local)
BCRYPT_ROUNDS=12
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5

# Storage: local | cloudinary (credentials go in dev.local)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
API_BASE_URL=http://localhost:5000

# Super admin display name (credentials go in dev.local)
SUPER_ADMIN_NAME=Super Admin

# Messaging (credentials go in dev.local) — optional; dev mode logs SMS/WhatsApp/email to console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
