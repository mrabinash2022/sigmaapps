{
  "expo": {
    "name": "Localite",
    "slug": "localite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a7f4b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a7f4b"
      }
    },
    "extra": {
      "apiUrl": "http://192.168.29.170:5000"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Localite to use the microphone so you can speak your order list.",
          "speechRecognitionPermission": "Allow Localite to convert your spoken order into text.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
