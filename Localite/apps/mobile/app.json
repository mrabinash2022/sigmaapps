{
  "expo": {
    "name": "Localite",
    "slug": "localite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/localite-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a7f4b"
    },
    "icon": "./assets/localite-logo.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/localite-logo.png",
        "backgroundColor": "#1a7f4b"
      }
    },
    "extra": {
      "apiUrl": "http://192.168.29.170:5000"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset"
    ],
  }
}
